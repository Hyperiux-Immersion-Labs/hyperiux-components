{
  "name": "hyperiux",
  "version": "1.0.3",
  "description": "CLI for adding Hyperiux UI effects to your Next.js project. This package is a CLI installer only — it is not an importable JavaScript/TypeScript library.",
  "type": "module",
  "bin": {
    "hyperiux": "./src/index.js"
  },
  "files": [
    "src/commands",
    "src/utils",
    "src/index.js",
    "README.md"
  ],
  "scripts": {
    "build": "echo 'No build step — ESM source is shipped directly'",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "pack:dry": "npm pack --dry-run",
    "prepublishOnly": "npm run lint && npm run test && npm run pack:dry"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "ora": "^8.1.1",
    "prompts": "^2.4.2"
  },
  "keywords": [
    "hyperiux",
    "ui",
    "effects",
    "animations",
    "cli",
    "components",
    "nextjs",
    "gsap",
    "three",
    "webgl"
  ],
  "author": "Hyperiux <admin@hyperiux.com>",
  "license": "MIT",
  "homepage": "https://components.hyperiux.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Hyperiux-Immersion-Labs/hyperiux-components.git"
  },
  "bugs": {
    "url": "https://github.com/Hyperiux-Immersion-Labs/hyperiux-components/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "devDependencies": {
    "eslint": "^9",
    "vitest": "^4.1.8"
  }
}
