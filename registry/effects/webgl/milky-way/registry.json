{
  "name": "milky-way",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Milky Way",
  "description": "GPU-accelerated GPGPU particle galaxy with spiral arms, curl-noise nebula smoke, twinkling sparkle stars, background starfield, and post-processing vignette + edge blur.",
  "category": "webgl",
  "dependencies": [
    "@react-three/drei",
    "@react-three/fiber",
    "@react-three/postprocessing",
    "gsap",
    "lucide-react",
    "postprocessing",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/milky-way",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "MilkyWay",
  "exportKind": "default",
  "importPath": "@/components/effects/milky-way",
  "target": "src/components/effects/milky-way",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/milky-way/index.tsx"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "particleSize",
      "type": "number",
      "default": 2,
      "description": "Particle and nebula point size multiplier.",
      "suggested": true
    },
    {
      "name": "numberOfParticles",
      "type": "number",
      "default": 80000,
      "description": "Number of star particles in the galaxy."
    },
    {
      "name": "coreColor",
      "type": "string",
      "default": "#ffbb00",
      "description": "Bright inner galaxy and starfield color.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ffffff",
      "description": "Nebula and sparkle accent color.",
      "suggested": true
    },
    {
      "name": "outerColor",
      "type": "string",
      "default": "#4400ff",
      "description": "Outer arm and warm sparkle color.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000114",
      "description": "Canvas background color.",
      "suggested": true
    },
    {
      "name": "rotation",
      "type": "number",
      "default": 1.6,
      "description": "How strongly the galaxy tilts with mouse movement.",
      "suggested": true
    },
    {
      "name": "mouseInfluence",
      "type": "boolean",
      "default": true,
      "description": "Enable cursor-driven galaxy tilt.",
      "suggested": true
    },
    {
      "name": "rotationSpeed",
      "type": "number",
      "default": 0.9,
      "description": "Speed the particles orbit around the galaxy centre.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "particleSize",
        "label": "Particle Size",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0.2,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "numberOfParticles",
        "label": "Number of Particles",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 10000,
        "max": 250000,
        "step": 5000
      },
      {
        "name": "coreColor",
        "label": "Core Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "outerColor",
        "label": "Outer Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "rotation",
        "label": "Rotation",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 2,
        "step": 0.05,
        "visibleWhen": {
          "name": "mouseInfluence",
          "eq": true
        }
      },
      {
        "name": "mouseInfluence",
        "label": "Mouse Influence",
        "type": "checkbox",
        "group": "motion",
        "copyable": true
      },
      {
        "name": "rotationSpeed",
        "label": "Rotation Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    ]
  }
}
