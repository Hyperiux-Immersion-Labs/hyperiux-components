{
  "name": "milky-way",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Milky Way",
  "description": "GPU-accelerated GPGPU particle galaxy with spiral arms, curl-noise nebula smoke, twinkling sparkle stars, background starfield, and post-processing vignette + edge blur.",
  "category": "webgl",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/drei",
    "@react-three/postprocessing",
    "postprocessing",
    "three",
    "lucide-react",
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/milky-way",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "MilkyWay",
  "exportKind": "default",
  "importPath": "@/components/effects/milky-way",
  "target": "src/components/effects/milky-way",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/milky-way/index.tsx"
    },
    {
      "path": "circular-text.tsx",
      "target": "src/components/effects/milky-way/circular-text.tsx"
    },
    {
      "path": "edge-blur-effect.tsx",
      "target": "src/components/effects/milky-way/edge-blur-effect.tsx"
    },
    {
      "path": "createSuspendedRaf.ts",
      "target": "src/components/effects/milky-way/createSuspendedRaf.ts"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-21",
      "summary": "Add prefers-reduced-motion support",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "particleSize",
      "type": "number",
      "default": 1,
      "description": "Particle and nebula point size multiplier.",
      "suggested": true
    },
    {
      "name": "coreColor",
      "type": "string",
      "default": "#f5f5ff",
      "description": "Bright inner galaxy and starfield color.",
      "suggested": true
    },
    {
      "name": "accentColor",
      "type": "string",
      "default": "#ffe6ad",
      "description": "Nebula and sparkle accent color.",
      "suggested": true
    },
    {
      "name": "outerColor",
      "type": "string",
      "default": "#e05c12",
      "description": "Outer arm and warm sparkle color.",
      "suggested": true
    },
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#000000",
      "description": "Canvas background color.",
      "suggested": true
    },
    {
      "name": "rotation",
      "type": "number",
      "default": 1,
      "description": "How strongly the galaxy tilts with mouse movement.",
      "suggested": true
    },
    {
      "name": "mouseInfluence",
      "type": "boolean",
      "default": true,
      "description": "Enable cursor-driven galaxy tilt.",
      "suggested": true
    },
    {
      "name": "rotationSpeed",
      "type": "number",
      "default": 0.2,
      "description": "Galaxy simulation and auto-rotation speed.",
      "suggested": true
    }
  ],
  "remixer": {
    "enabled": true,
    "suggested": true,
    "defaultOpenGroupId": "controls",
    "layout": {
      "controlsButtonClassName": "right-4! top-25!"
    },
    "panel": {
      "className": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "controls": [
      {
        "name": "particleSize",
        "label": "Particle Size",
        "type": "range",
        "group": "controls",
        "copyable": true,
        "min": 0.2,
        "max": 3,
        "step": 0.05
      },
      {
        "name": "coreColor",
        "label": "Core Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "accentColor",
        "label": "Accent Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "outerColor",
        "label": "Outer Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "backgroundColor",
        "label": "Background Color",
        "type": "color",
        "group": "style",
        "copyable": true
      },
      {
        "name": "rotation",
        "label": "Rotation",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 2,
        "step": 0.05
      },
      {
        "name": "mouseInfluence",
        "label": "Mouse Influence",
        "type": "checkbox",
        "group": "motion",
        "copyable": true
      },
      {
        "name": "rotationSpeed",
        "label": "Rotation Speed",
        "type": "range",
        "group": "motion",
        "copyable": true,
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    ]
  }
}
