{
  "name": "moss-grid",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-11-02",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Moss Grid",
  "description": "Rolling hills of shimmering grid lights revealed around the pointer.",
  "category": "backgrounds",
  "dependencies": [
    "@react-three/fiber",
    "@react-three/postprocessing",
    "postprocessing",
    "three"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/moss-grid",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "MossGrid",
  "exportKind": "default",
  "importPath": "@/components/effects/moss-grid",
  "target": "src/components/effects/moss-grid",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/moss-grid/index.tsx"
    }
  ],
  "props": [
    {
      "name": "mossColor",
      "label": "Moss",
      "type": "color",
      "default": "#22331a",
      "description": "Moss in the hollows and at the base of the strands.",
      "remixer": {
        "control": "color",
        "group": "look",
        "groupTitle": "Look"
      }
    },
    {
      "name": "mossHighlight",
      "label": "Moss tips",
      "type": "color",
      "default": "#628c58",
      "description": "Moss at the tips of the strands and on the crests.",
      "remixer": {
        "control": "color",
        "group": "look",
        "groupTitle": "Look"
      }
    },
    {
      "name": "dotColor",
      "label": "Lights",
      "type": "color",
      "default": "#c3e4e0",
      "description": "Colour of the lights.",
      "remixer": {
        "control": "color",
        "group": "look",
        "groupTitle": "Look"
      }
    },
    {
      "name": "dotSize",
      "label": "Light size",
      "type": "number",
      "default": 1.5,
      "description": "Size of each light, in px at the focus distance.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 1,
        "max": 6,
        "step": 0.1
      }
    },
    {
      "name": "dotGlow",
      "label": "Light glow",
      "type": "number",
      "default": 1,
      "description": "Brightness of the lights.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "depthOfField",
      "label": "Depth of field",
      "type": "number",
      "default": 1,
      "description": "How blurred the far hills are. 0 keeps everything sharp.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "grain",
      "label": "Grain",
      "type": "number",
      "default": 0.09,
      "description": "Film grain strength. 0 turns it off.",
      "remixer": {
        "control": "range",
        "group": "look",
        "groupTitle": "Look",
        "min": 0,
        "max": 0.3,
        "step": 0.01
      }
    },
    {
      "name": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "description": "How fast everything moves. 0 holds it still.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "undulate",
      "label": "Roll",
      "type": "number",
      "default": 1,
      "description": "How much the hills drift. 0 keeps the ground fixed.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "interactive",
      "label": "Cursor",
      "type": "boolean",
      "default": true,
      "description": "Light up the grid where the pointer moves, swell the ground under it and ripple the lights.",
      "remixer": {
        "control": "checkbox",
        "group": "cursor",
        "groupTitle": "Cursor"
      }
    },
    {
      "name": "autoplay",
      "label": "Autoplay",
      "type": "boolean",
      "default": true,
      "description": "Wander a light across the moss on its own when the pointer is away or still.",
      "remixer": {
        "control": "checkbox",
        "group": "cursor",
        "groupTitle": "Cursor"
      }
    },
    {
      "name": "idleDelay",
      "label": "Idle delay",
      "type": "number",
      "default": 1.5,
      "description": "Seconds the pointer can rest before the light wanders off on its own.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.2,
        "max": 6,
        "step": 0.1
      }
    },
    {
      "name": "revealRadius",
      "label": "Reveal size",
      "type": "number",
      "default": 0.6,
      "description": "Size of the pool of light around the pointer, in world units.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.2,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "trail",
      "label": "Trail",
      "type": "number",
      "default": 1.2,
      "description": "How long the trail of light behind the pointer lingers, in seconds.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.1,
        "max": 4,
        "step": 0.05
      }
    },
    {
      "name": "ambient",
      "label": "Ambient",
      "type": "number",
      "default": 0,
      "description": "How visible the grid is away from the pointer. 0 hides it, so it shows only where the pointer is.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0,
        "max": 1,
        "step": 0.01
      }
    },
    {
      "name": "cursorStrength",
      "label": "Swell",
      "type": "number",
      "default": 1,
      "description": "How strongly the pointer swells the ground.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "cursorRadius",
      "label": "Swell reach",
      "type": "number",
      "default": 1.2,
      "description": "How far the swell under the pointer reaches, in world units.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.3,
        "max": 3,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
