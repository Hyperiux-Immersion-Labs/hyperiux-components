{
  "name": "opal-flow",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-11-02",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Opal Flow",
  "description": "A periwinkle ground with a pink-to-peach ribbon and cyan wisps that smear under the pointer.",
  "category": "backgrounds",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/opal-flow",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "OpalFlow",
  "exportKind": "default",
  "importPath": "@/components/effects/opal-flow",
  "target": "src/components/effects/opal-flow",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/opal-flow/index.tsx"
    }
  ],
  "props": [
    {
      "name": "baseColor",
      "label": "Ground",
      "type": "color",
      "default": "#6a6cf6",
      "description": "The periwinkle ground.",
      "remixer": {
        "control": "color",
        "group": "colour",
        "groupTitle": "Colour"
      }
    },
    {
      "name": "wispColor",
      "label": "Wisps",
      "type": "color",
      "default": "#8de0f1",
      "description": "The cyan wisps.",
      "remixer": {
        "control": "color",
        "group": "colour",
        "groupTitle": "Colour"
      }
    },
    {
      "name": "ribbonColor",
      "label": "Ribbon",
      "type": "color",
      "default": "#fb9ce8",
      "description": "The pink ribbon.",
      "remixer": {
        "control": "color",
        "group": "colour",
        "groupTitle": "Colour"
      }
    },
    {
      "name": "highlightColor",
      "label": "Highlight",
      "type": "color",
      "default": "#fccbbf",
      "description": "The warm centre of the ribbon.",
      "remixer": {
        "control": "color",
        "group": "colour",
        "groupTitle": "Colour"
      }
    },
    {
      "name": "hue",
      "label": "Hue",
      "type": "number",
      "default": 0,
      "description": "Turns every colour around the colour wheel, in degrees. 0 is the reference palette.",
      "remixer": {
        "control": "range",
        "group": "colour",
        "groupTitle": "Colour",
        "min": -180,
        "max": 180,
        "step": 1
      }
    },
    {
      "name": "saturation",
      "label": "Saturation",
      "type": "number",
      "default": 1,
      "description": "Colour strength. 0 is greyscale, 1 matches the reference.",
      "remixer": {
        "control": "range",
        "group": "colour",
        "groupTitle": "Colour",
        "min": 0,
        "max": 1.6,
        "step": 0.05
      }
    },
    {
      "name": "grain",
      "label": "Grain",
      "type": "number",
      "default": 0.025,
      "description": "Film grain strength. 0 turns it off.",
      "remixer": {
        "control": "range",
        "group": "colour",
        "groupTitle": "Colour",
        "min": 0,
        "max": 0.15,
        "step": 0.005
      }
    },
    {
      "name": "speed",
      "label": "Speed",
      "type": "number",
      "default": 1,
      "description": "How fast the paint flows. 0 holds it still.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 4,
        "step": 0.05
      }
    },
    {
      "name": "flow",
      "label": "Flow",
      "type": "number",
      "default": 1,
      "description": "How far the paint folds and curls.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "detail",
      "label": "Detail",
      "type": "number",
      "default": 1,
      "description": "How strongly the cyan wisps are combed into fine streaks.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 2.5,
        "step": 0.05
      }
    },
    {
      "name": "interactive",
      "label": "Smear",
      "type": "boolean",
      "default": true,
      "description": "Let the pointer stir the paint like ink in water.",
      "remixer": {
        "control": "checkbox",
        "group": "cursor",
        "groupTitle": "Cursor"
      }
    },
    {
      "name": "smearStrength",
      "label": "Strength",
      "type": "number",
      "default": 1,
      "description": "How far a stroke drags the paint.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "smearRadius",
      "label": "Brush size",
      "type": "number",
      "default": 0.1,
      "description": "Width of the stroke, in canvas heights.",
      "remixer": {
        "control": "range",
        "group": "cursor",
        "groupTitle": "Cursor",
        "min": 0.04,
        "max": 0.4,
        "step": 0.01
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
