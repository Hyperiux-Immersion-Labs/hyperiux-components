{
  "name": "ellipse-carousel",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-08-21",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Ellipse Carousel",
  "description": "Elliptical card carousel with autoplay, drag interaction, mobile-specific ellipse tuning, and an optional center label.",
  "category": "carousels",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/ellipse-carousel",
  "tier": "free",
  "main": "index.tsx",
  "exportName": "EllipseCarousel",
  "exportKind": "default",
  "importPath": "@/components/effects/ellipse-carousel",
  "target": "src/components/effects/ellipse-carousel",
  "props": [
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#eeeeee",
      "description": "Background fill behind the carousel stage.",
      "remixer": {
        "control": "color",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "centerLabel",
      "type": "string",
      "default": "HYPERIUX",
      "description": "Text shown at the center of the ellipse when enabled.",
      "remixer": {
        "enabled": false,
        "control": "text",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "showCenterLabel",
      "type": "boolean",
      "default": true,
      "description": "Shows or hides the center label.",
      "remixer": {
        "control": "checkbox",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "cardWidth",
      "type": "number",
      "default": 130,
      "description": "Card width at the largest active position, in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 80,
        "max": 260,
        "step": 1
      }
    },
    {
      "name": "cardHeight",
      "type": "number",
      "default": 180,
      "description": "Card height at the largest active position, in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 110,
        "max": 340,
        "step": 1
      }
    },
    {
      "name": "minScale",
      "type": "number",
      "default": 0.2,
      "description": "Minimum scale applied to the farthest cards on the ellipse.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0.05,
        "max": 0.8,
        "step": 0.01
      }
    },
    {
      "name": "radiusXRatio",
      "type": "number",
      "default": 0.25,
      "description": "Horizontal ellipse radius as a fraction of the stage width.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0.1,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "radiusYRatio",
      "type": "number",
      "default": 0.36,
      "description": "Vertical ellipse radius as a fraction of the stage height.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0.1,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "autoPlay",
      "type": "boolean",
      "default": true,
      "description": "Automatically advances the carousel by one card at a time.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "holdDuration",
      "type": "number",
      "default": 1,
      "description": "Seconds to hold on the active card before advancing.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 0,
        "max": 3,
        "step": 0.05
      }
    },
    {
      "name": "stepDuration",
      "type": "number",
      "default": 0.7,
      "description": "Seconds for the snap transition between cards.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 0.1,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "pauseOnHover",
      "type": "boolean",
      "default": true,
      "description": "Pauses autoplay while hovering a card.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "draggable",
      "type": "boolean",
      "default": true,
      "description": "Allows users to drag the ellipse by hand.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "dragSensitivity",
      "type": "number",
      "default": 1,
      "description": "Multiplier on the carousel's angular drag response.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 0.2,
        "max": 3,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "appearance",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/ellipse-carousel/index.tsx"
    },
    {
      "path": "EllipseCarousel.tsx",
      "target": "src/components/effects/ellipse-carousel/EllipseCarousel.tsx"
    }
  ]
}
