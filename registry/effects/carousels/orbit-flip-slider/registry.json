        "control": "range",
        "group": "flat",
        "groupTitle": "Flat",
        "min": 0.3,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "flatRadiusY",
      "type": "number",
      "default": 1.2,
      "description": "Vertical stretch of the flat circle, as a multiplier of its base radius.",
      "remixer": {
        "enabled": false,
        "control": "range",
        "group": "flat",
        "groupTitle": "Flat",
        "min": 0.3,
        "max": 2,
        "step": 0.05
      }
    },
