      "name": "rotate",
      "type": "boolean",
      "default": true,
      "description": "Continuously and slowly rotates the ring of cards.",
      "remixer": {
        "control": "checkbox",
        "group": "general",
        "groupTitle": "General"
      }
    },
    {
      "name": "rotateSpeed",
      "type": "number",
      "default": 4,
      "description": "Speed of the automatic rotation, in degrees per second.",
      "remixer": {
        "control": "range",
        "group": "general",
        "groupTitle": "General",
        "min": 0.5,
        "max": 30,
        "step": 0.5
