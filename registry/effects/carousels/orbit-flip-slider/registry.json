{
  "name": "orbit-flip-slider",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-08-20",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Orbit Flip Slider",
  "description": "GSAP Flip-driven gallery that morphs one ring of images between four camera views — a flat circle, a zoomed-in upper arc, a tilted 3D ring, and a coverflow band — with a bouncy 3D hover tilt on every card.",
  "category": "carousels",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/orbit-flip-slider",
  "coverImage": "orbit-flip-slider",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "OrbitFlipSlider",
  "exportKind": "default",
  "importPath": "@/components/effects/orbit-flip-slider",
  "target": "src/components/effects/orbit-flip-slider",
  "props": [
    {
      "name": "backgroundColor",
      "type": "string",
      "default": "#e9e9ea",
      "description": "Background color behind the ring.",
      "remixer": {
        "control": "color",
        "group": "colors",
        "groupTitle": "Colors"
      }
    },
    {
      "name": "imageWidth",
      "type": "number",
      "default": 90,
      "description": "Width of each image card in pixels.",
      "remixer": {
        "control": "range",
        "group": "general",
        "groupTitle": "General",
        "min": 80,
        "max": 320,
        "step": 4
      }
    },
    {
      "name": "imageHeight",
      "type": "number",
      "default": 140,
      "description": "Height of each image card in pixels.",
      "remixer": {
        "control": "range",
        "group": "general",
        "groupTitle": "General",
        "min": 120,
        "max": 420,
        "step": 4
      }
    },
    {
      "name": "imageGap",
      "type": "number",
      "default": 0,
      "description": "Extra spacing between image cards in pixels.",
      "remixer": {
        "control": "range",
        "group": "general",
        "groupTitle": "General",
        "min": 0,
        "max": 120,
        "step": 2
      }
    },
    {
      "name": "rounded",
      "type": "string",
      "default": "rounded-none",
      "description": "Tailwind border-radius class applied to each image card.",
      "remixer": {
        "control": "select",
        "group": "general",
        "groupTitle": "General",
        "options": [
          "rounded-none",
          "rounded-sm",
          "rounded-md",
          "rounded-lg",
          "rounded-xl",
          "rounded-2xl",
          "rounded-3xl",
          "rounded-full"
        ]
      }
    },
    {
      "name": "enableHoverMovement",
      "type": "boolean",
      "default": true,
      "description": "Enables the hover lift and perspective tilt on image cards.",
      "remixer": {
        "control": "checkbox",
        "group": "general",
        "groupTitle": "General"
      }
    },
    {
      "name": "hoverMoveY",
      "type": "number",
      "default": -8,
      "description": "Vertical movement applied to the image card on hover, in pixels.",
      "remixer": {
        "control": "range",
        "group": "general",
        "groupTitle": "General",
        "min": -80,
        "max": 80,
        "step": 1
      }
    },
    {
      "name": "perspectiveRotateValue",
      "type": "number",
