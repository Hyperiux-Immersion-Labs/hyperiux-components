{
  "name": "zoom-slider",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-28",
      "summary": "Added reduced-motion support and exposed title, subheading, and sliderData as public props.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-06-04",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Zoom Slider",
  "description": "Infinitely looping horizontal image carousel where the active card expands using a quadratic easing curve as it enters from the right. Supports scroll, drag, and touch. Hover reveals GSAP SplitText line animations above each card.",
  "category": "carousels",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/zoom-slider",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "ZoomSlider",
  "exportKind": "default",
  "importPath": "@/components/effects/zoom-slider",
  "target": "src/components/effects/zoom-slider",
  "props": [
    {
      "name": "scaleOnHover",
      "type": "boolean",
      "description": "Enables the image scale-up effect on hover.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "hover",
        "groupTitle": "Hover",
        "groupCollapsible": false
      }
    },
    {
      "name": "textOnHover",
      "type": "boolean",
      "description": "Enables the hover text reveal above each slide.",
      "default": true,
      "remixer": {
        "control": "checkbox",
        "group": "hover",
        "groupTitle": "Hover",
        "groupCollapsible": false
      }
    },
    {
      "name": "size",
      "type": "number",
      "description": "Multiplier applied to zoom slider card width and height.",
      "default": 1,
      "remixer": {
        "control": "range",
        "group": "style",
        "groupTitle": "Style",
        "min": 0.5,
        "max": 1.6,
        "step": 0.05
      }
    },
    {
      "name": "easeScrollPercentage",
      "type": "number",
      "description": "Percentage of viewport distance used by the horizontal easing curve.",
      "default": 100,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 20,
        "max": 180,
        "step": 1
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "hover",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/zoom-slider/index.tsx"
    },
    {
      "path": "ZoomSliderComp.tsx",
      "target": "src/components/effects/zoom-slider/ZoomSliderComp.tsx"
    }
  ]
}
