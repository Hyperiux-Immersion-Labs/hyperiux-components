{
  "name": "link-button",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-07-14",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Link Button",
  "description": "Minimal link button with animated underline and rotating arrow icon",
  "category": "buttons",
  "dependencies": [
    "lucide-react"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/link-button",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "LinkButton",
  "exportKind": "default",
  "importPath": "@/components/effects/link-button",
  "target": "src/components/effects/link-button",
  "props": [
    {
      "name": "btnText",
      "type": "string",
      "default": "Hover me",
      "description": "Button label text.",
      "remixer": {
        "control": "text",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "mobileText",
      "type": "string",
      "default": "Click me",
      "description": "Label used on compact viewports."
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#ffffff",
      "description": "Resting label and underline color.",
      "remixer": {
        "control": "color",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "hoverColor",
      "type": "color",
      "default": "#ff6b00",
      "description": "Hover label and underline color.",
      "remixer": {
        "control": "color",
        "group": "appearance",
        "groupTitle": "Appearance"
      }
    },
    {
      "name": "clickedColor",
      "type": "color",
      "default": "#ff6b00",
      "description": "Compact viewport color after tapping."
    },
    {
      "name": "underlineHeight",
      "type": "number",
      "default": 1.5,
      "description": "Underline thickness in pixels.",
      "remixer": {
        "control": "range",
        "group": "underline",
        "groupTitle": "Underline",
        "min": 0.5,
        "max": 6,
        "step": 0.5
      }
    },
    {
      "name": "showIcon",
      "type": "boolean",
      "default": true,
      "description": "Shows or hides the arrow icon.",
      "remixer": {
        "control": "checkbox",
        "group": "icon",
        "groupTitle": "Icon"
      }
    },
    {
      "name": "transitionDuration",
      "type": "number",
      "default": 0.5,
      "description": "Animation duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1.5,
        "step": 0.05
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "appearance",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/link-button/index.tsx"
    }
  ]
}
