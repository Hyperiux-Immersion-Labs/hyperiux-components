{
  "name": "circular-split-roll",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-24",
      "summary": "Fixed responsiveness issues and added a reduced-motion notice explaining the continuous scroll-driven rotation.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Circular Split Roll",
  "description": "Split circular slider with orbiting titles on one side and image cards on the other",
  "category": "scroll",
  "dependencies": [
    "gsap",
    "lenis"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/circular-split-roll",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "CircularSplitRoll",
  "exportKind": "default",
  "importPath": "@/components/effects/circular-split-roll",
  "target": "src/components/effects/circular-split-roll",
  "props": [
    {
      "name": "radius",
      "type": "number",
      "default": 500,
      "description": "Radius of both rotating rings.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 100,
        "max": 900,
        "step": 10
      }
    },
    {
      "name": "cardSize",
      "type": "number",
      "default": 205,
      "description": "Size of the right-rail image cards.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 80,
        "max": 420,
        "step": 1
      }
    },
    {
      "name": "textSideScale",
      "type": "number",
      "default": 0.68,
      "description": "Title scale away from the center.",
      "remixer": {
        "control": "range",
        "group": "text",
        "groupTitle": "Text",
        "min": 0.1,
        "max": 1.5,
        "step": 0.02
      }
    },
    {
      "name": "textSideOpacity",
      "type": "number",
      "default": 0.18,
      "description": "Title opacity away from the center.",
      "remixer": {
        "control": "range",
        "group": "text",
        "groupTitle": "Text",
        "min": 0,
        "max": 1,
        "step": 0.02
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "layout",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/circular-split-roll/index.tsx"
    },
    {
      "path": "CircularSplitRollComp.tsx",
      "target": "src/components/effects/circular-split-roll/CircularSplitRollComp.tsx"
    }
  ]
}
