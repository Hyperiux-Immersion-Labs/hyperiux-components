{
  "name": "image-pixel-reveal",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-26",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Image Pixel Reveal",
  "description": "Scroll-driven reveal that builds an image out of square pixels along a scattered edge.",
  "category": "scroll",
  "dependencies": [
    "@gsap/react",
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/image-pixel-reveal",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "ImagePixelReveal",
  "exportKind": "default",
  "importPath": "@/components/effects/image-pixel-reveal",
  "target": "src/components/effects/image-pixel-reveal",
  "props": [
    {
      "name": "imageSrc",
      "type": "string",
      "default": "",
      "description": "Image to reveal. Or pass your own content as children.",
      "copyable": false
    },
    {
      "name": "gridSize",
      "type": "number",
      "default": 24,
      "description": "Size of each pixel cell, in px.",
      "remixer": {
        "control": "range",
        "group": "pixels",
        "groupTitle": "Pixels",
        "min": 6,
        "max": 60,
        "step": 1
      },
      "demoDefault": 14
    },
    {
      "name": "edgeHeight",
      "type": "number",
      "default": 0.3,
      "description": "How wide the scattered pixel edge is, from 0 (clean line) to 1.",
      "remixer": {
        "control": "range",
        "group": "pixels",
        "groupTitle": "Pixels",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      },
      "demoDefault": 0.35
    },
    {
      "name": "direction",
      "type": "string",
      "default": "down",
      "description": "Which way the reveal travels across the image.",
      "remixer": {
        "control": "select",
        "group": "motion",
        "groupTitle": "Motion",
        "options": [
          {
            "label": "Down",
            "value": "down"
          },
          {
            "label": "Up",
            "value": "up"
          },
          {
            "label": "Left",
            "value": "left"
          },
          {
            "label": "Right",
            "value": "right"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "parallax",
      "type": "number",
      "default": 0.5,
      "description": "Demo only: strength of the scroll parallax on each image. 0 turns it off.",
      "copyable": false,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 2,
        "step": 0.1,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "scrub",
      "type": "boolean",
      "default": false,
      "description": "Tie the reveal to scroll position. Off plays it once on enter.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion",
        "hideWhenReducedMotion": true
      },
      "demoDefault": true
    },
    {
      "name": "duration",
      "type": "number",
      "default": 1.4,
      "description": "Length of the reveal in seconds when not scrubbing.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.3,
        "max": 4,
        "step": 0.1,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "start",
      "type": "string",
      "default": "top 90%",
      "description": "ScrollTrigger start position."
    },
    {
      "name": "end",
      "type": "string",
      "default": "top 40%",
      "description": "ScrollTrigger end position, used when scrubbing."
    },
    {
      "name": "className",
      "type": "string",
      "default": "",
      "description": "Extra classes on the wrapper."
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": {},
    "panel": {}
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/image-pixel-reveal/index.tsx"
    }
  ]
}
