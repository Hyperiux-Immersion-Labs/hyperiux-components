{
  "name": "rectangular-text-reveal",
  "version": "1.1.0",
  "changelog": [
    {
      "version": "1.1.0",
      "date": "2026-07-21",
      "summary": "Added reduced-motion support for accessible lower-motion rectangular reveal.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Rectangular Text Reveal",
  "description": "Text reveal animation with colored rectangles sliding across each line",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/rectangular-text-reveal",
  "tier": "free",
  "exportName": "RectangularTextReveal",
  "exportKind": "default",
  "main": "index.tsx",
  "props": [
    { "name": "baseColor", "type": "string", "default": "#ea580c", "description": "Base reveal rectangle color.", "remixer": { "control": "color", "group": "colors", "groupTitle": "Colors" } },
    { "name": "overlayColor", "type": "string", "default": "#111111", "description": "Overlay reveal rectangle color.", "remixer": { "control": "color", "group": "colors", "groupTitle": "Colors" } },
    { "name": "useOverlay", "type": "boolean", "default": true, "description": "Enables the overlay pass.", "remixer": { "control": "checkbox", "group": "behavior", "groupTitle": "Behavior" } },
    { "name": "stagger", "type": "number", "default": 0.2, "description": "Delay between line reveals.", "remixer": { "control": "range", "group": "timing", "groupTitle": "Timing", "min": 0, "max": 1, "step": 0.05 } },
    { "name": "coverDuration", "type": "number", "default": 0.34, "description": "Cover animation duration.", "remixer": { "control": "range", "group": "timing", "groupTitle": "Timing", "min": 0.1, "max": 2, "step": 0.05 } },
    { "name": "revealDuration", "type": "number", "default": 0.42, "description": "Reveal animation duration.", "remixer": { "control": "range", "group": "timing", "groupTitle": "Timing", "min": 0.1, "max": 2, "step": 0.05 } },
    { "name": "direction", "type": "string", "default": "left", "description": "Reveal direction.", "remixer": { "control": "select", "group": "behavior", "groupTitle": "Behavior", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" }, { "value": "top", "label": "Top" }, { "value": "bottom", "label": "Bottom" } ] } }
  ],
  "remixer": { "enabled": true, "defaultOpenGroupId": "colors", "layout": { "buttonClassName": "right-4! top-25!", "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!" }, "copyCode": { "includeOnlyPublicProps": true } },
  "files": [
    {
      "path": "index.tsx",
      "type": "registry:component",
      "target": "src/components/effects/rectangular-text-reveal/index.tsx"
    }
  ]
}
