{
  "name": "number-counter",
  "version": "1.0.1",
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added reduced-motion support and reworked the props API to working duration/stagger controls across all counter variants.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-02-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Number Counter",
  "description": "Scroll-triggered number counters with digit rolling animations (multiple variants).",
  "category": "text",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/number-counter",
  "coverImage": "number-counter",
  "videoUrl": "/number-counter.mp4",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "NumberCounter",
  "exportKind": "default",
  "importPath": "@/components/effects/number-counter",
  "target": "src/components/effects/number-counter",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/number-counter/index.tsx"
    },
    {
      "path": "NumberCounterOne.tsx",
      "target": "src/components/effects/number-counter/NumberCounterOne.tsx"
    },
    {
      "path": "NumberCounterTwo.tsx",
      "target": "src/components/effects/number-counter/NumberCounterTwo.tsx"
    },
    {
      "path": "NumberCounterThree.tsx",
      "target": "src/components/effects/number-counter/NumberCounterThree.tsx"
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 1.5,
      "description": "Digit roll duration in seconds for all three counters.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.2,
        "max": 4,
        "step": 0.05
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.1,
      "description": "Delay between digit columns in seconds for all three counters.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.5,
        "step": 0.01
      }
    },
    {
      "name": "textColor",
      "type": "string",
      "default": "#021A54",
      "description": "Counter text color for all three counters.",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
