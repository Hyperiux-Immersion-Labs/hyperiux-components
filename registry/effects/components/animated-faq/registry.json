{
  "name": "animated-faq",
  "version": "2.0.0",
  "type": "registry:component",
  "title": "Animated FAQ",
  "description": "Accessible FAQ accordion with smooth or elastic Motion animations, staggered answers and fills",
  "category": "components",
  "dependencies": [
    "lucide-react",
    "motion"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-faq",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedFaq",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-faq",
  "target": "src/components/effects/animated-faq",
  "props": [
    {
      "name": "allowMultiple",
      "type": "boolean",
      "default": false,
      "description": "Lets more than one FAQ answer stay open at once.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "openOnHover",
      "type": "boolean",
      "default": false,
      "description": "Answers open while a mouse rests on them and close when it leaves. Touch still uses taps.",
      "remixer": {
        "control": "checkbox",
        "group": "behavior",
        "groupTitle": "Behavior"
      }
    },
    {
      "name": "fill",
      "type": "string",
      "default": "none",
      "description": "A background that grows down from the top while an item is open.",
      "remixer": {
        "control": "select",
        "group": "item",
        "groupTitle": "Item",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "Muted",
            "value": "muted"
          },
          {
            "label": "Accent",
            "value": "accent"
          }
        ]
      }
    },
    {
      "name": "accentColor",
      "type": "color",
      "default": "#ff6b00",
      "description": "Colour of the accent fill.",
      "remixer": {
        "control": "color",
        "group": "item",
        "groupTitle": "Item"
      }
    },
    {
      "name": "duration",
      "type": "number",
      "default": 0.45,
      "description": "Open and close animation duration.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1.5,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "elastic",
      "type": "boolean",
      "default": false,
      "description": "Springs instead of easing for the panel, fill, line and content.",
      "remixer": {
        "control": "checkbox",
        "group": "motion",
        "groupTitle": "Motion",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "bounce",
      "type": "number",
      "default": 0.3,
      "description": "How much the springs overshoot. Needs Elastic.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.8,
        "step": 0.05,
        "disabledWhen": {
          "prop": "elastic",
          "equals": false
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "delay",
      "type": "number",
      "default": 0.1,
      "description": "Seconds before the answer starts to appear.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "stagger",
      "type": "number",
      "default": 0.05,
      "description": "Seconds between each part of the answer appearing.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.3,
        "step": 0.01,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "showIcon",
      "type": "boolean",
      "default": true,
      "description": "Shows or hides the FAQ trigger icon.",
      "remixer": {
        "control": "checkbox",
        "group": "icon",
        "groupTitle": "Icon"
      }
    },
    {
      "name": "iconPosition",
      "type": "string",
      "default": "right",
      "description": "Side where the trigger icon is rendered.",
      "remixer": {
        "control": "select",
        "group": "icon",
        "groupTitle": "Icon",
        "options": [
          {
            "value": "right",
            "label": "Right"
          },
          {
            "value": "left",
            "label": "Left"
          }
        ]
      }
    },
    {
      "name": "iconMode",
      "type": "string",
      "default": "rotate",
      "description": "Icon animation: a chevron that turns down or right, or a plus that turns into a minus.",
      "remixer": {
        "control": "select",
        "group": "icon",
        "groupTitle": "Icon",
        "options": [
          {
            "value": "rotate",
            "label": "Rotate Down"
          },
          {
            "value": "rotate-left-down",
            "label": "Rotate Right"
          },
          {
            "value": "plus",
            "label": "Plus / minus"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "behavior",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  },
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-faq/index.tsx"
    }
  ],
  "changelog": [
    {
      "version": "2.0.0",
      "date": "2026-10-28",
      "breaking": true,
      "summary": "Rebuilt on Motion with the Animated Accordion features: open on hover, elastic springs, delayed and staggered answers, muted or accent fill and a plus/minus icon. Replaces gsap with motion."
    },
    {
      "version": "1.0.1",
      "date": "2026-07-28",
      "summary": "Updated accordion behavior and documented reduced-motion support.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-22",
      "summary": "Initial release",
      "breaking": false
    }
  ]
}
