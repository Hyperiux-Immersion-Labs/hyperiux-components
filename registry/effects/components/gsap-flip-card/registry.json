{
  "name": "gsap-flip-card",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-09-10",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "GSAP Flip Card",
  "description": "A card stack that expands into a hero image and thumbnail rail with GSAP Flip transitions.",
  "category": "components",
  "dependencies": [
    "gsap"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/gsap-flip-card",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "GsapFlipCard",
  "exportKind": "default",
  "importPath": "@/components/effects/gsap-flip-card",
  "target": "src/components/effects/gsap-flip-card",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/gsap-flip-card/index.tsx"
    }
  ],
  "props": [
    {
      "name": "duration",
      "type": "number",
      "default": 0.7,
      "description": "Card transition duration in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "min": 0.2,
        "max": 2,
        "step": 0.05
      }
    },
    {
      "name": "rounded",
      "type": "number",
      "default": 20,
      "description": "Card corner radius in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "min": 0,
        "max": 60,
        "step": 1
      }
    },
    {
      "name": "stackOffsetX",
      "type": "number",
      "default": 3,
      "description": "Horizontal offset per card in the collapsed desktop stack.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "stackOffsetY",
      "type": "number",
      "default": 9,
      "description": "Vertical offset per card in the collapsed desktop stack.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "stackRotation",
      "type": "number",
      "default": 0,
      "description": "Rotation per card in the collapsed desktop stack, in degrees.",
      "remixer": {
        "control": "range",
        "group": "stack",
        "min": -15,
        "max": 15,
        "step": 1
      }
    },
    {
      "name": "thumbGap",
      "type": "number",
      "default": 12,
      "description": "Spacing between desktop rail thumbnails in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "min": 0,
        "max": 40,
        "step": 1
      }
    },
    {
      "name": "backgroundColor",
      "type": "color",
      "default": "#e9e9e7",
      "description": "Section background color.",
      "remixer": {
        "control": "color",
        "group": "colors"
      }
    },
    {
      "name": "textColor",
      "type": "color",
      "default": "#111111",
      "description": "Primary text color.",
      "remixer": {
        "control": "color",
        "group": "colors"
      }
    },
    {
      "name": "mutedColor",
      "type": "color",
      "default": "#8a8a86",
      "description": "Secondary text color.",
      "remixer": {
        "control": "color",
        "group": "colors"
      }
    },
    {
      "name": "ease",
      "type": "string",
      "default": "power3.inOut",
      "description": "GSAP transition easing.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "showCounter",
      "type": "boolean",
      "default": true,
      "description": "Shows the image counter.",
      "remixer": {
        "enabled": false
      }
    },
    {
      "name": "thumbWidth",
      "type": "number",
      "default": 108,
      "description": "Code-only configuration for thumbWidth."
    },
    {
      "name": "thumbHeight",
      "type": "number",
      "default": 120,
      "description": "Code-only configuration for thumbHeight."
    },
    {
      "name": "heroWidth",
      "type": "number",
      "default": 530,
      "description": "Code-only configuration for heroWidth."
    },
    {
      "name": "heroHeight",
      "type": "number",
      "default": 670,
      "description": "Code-only configuration for heroHeight."
    },
    {
      "name": "captionLines",
      "type": "number",
      "default": 2,
      "description": "Code-only configuration for captionLines."
    },
    {
      "name": "captionFadeDuration",
      "type": "number",
      "default": 0.25,
      "description": "Fade-out duration in seconds for all text sections."
    },
    {
      "name": "captionRevealDuration",
      "type": "number",
      "default": 0.55,
      "description": "Line-reveal duration in seconds for all text sections."
    },
    {
      "name": "captionLineStagger",
      "type": "number",
      "default": 0.07,
      "description": "Stagger between revealed lines across all text sections in seconds."
    },
    {
      "name": "title",
      "type": "string",
      "default": "GSAP Flip Card",
      "description": "Fallback title for items without a title."
    },
    {
      "name": "meta",
      "type": "string",
      "default": "Hyperiux Vault / GSAP Flip / React",
      "description": "Fallback metadata for items without metadata."
    },
    {
      "name": "description",
      "type": "string",
      "default": "A pile of cards that fans into a hero and a rail. Tap any frame and the two trade places, same nodes, measured and tweened, never re-mounted.",
      "description": "Fallback description for items without a description."
    },
    {
      "name": "className",
      "type": "string",
      "default": "",
      "description": "Code-only className."
    },
    {
      "name": "items",
      "type": "GsapFlipCardItem[]",
      "description": "Gallery images with optional IDs, alt text, titles, metadata, descriptions and captions; defaults to the built-in gallery."
    },
    {
      "name": "onClose",
      "type": "() => void",
      "description": "Called when the gallery closes."
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "motion",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
