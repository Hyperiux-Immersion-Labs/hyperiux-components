{
  "name": "hover-stack",
  "version": "1.0.1",
  "type": "registry:component",
  "title": "Hover Stack",
  "description": "Overlapping card stack that fans out around the hovered card",
  "category": "components",
  "dependencies": [],
  "registryDependencies": [],
  "previewUrl": "/demo/hover-stack",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "HoverStack",
  "exportKind": "default",
  "importPath": "@/components/effects/hover-stack",
  "target": "src/components/effects/hover-stack",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/hover-stack/index.tsx"
    },
    {
      "path": "HoverStackComp.tsx",
      "target": "src/components/effects/hover-stack/HoverStackComp.tsx"
    }
  ],
  "changelog": [
    {
      "version": "1.0.1",
      "date": "2026-07-30",
      "summary": "Added reduced-motion support, fixed the demo not rendering, and reworked the props API (items, spread, rotation, duration, accentColor) to match the real component.",
      "breaking": false
    },
    {
      "version": "1.0.0",
      "date": "2026-07-21",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "props": [
    {
      "name": "cardWidth",
      "type": "number",
      "default": 280,
      "description": "Width of each card in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 160,
        "max": 420,
        "step": 4
      }
    },
    {
      "name": "cardHeight",
      "type": "number",
      "default": 360,
      "description": "Height of each card in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 200,
        "max": 520,
        "step": 4
      }
    },
    {
      "name": "overlap",
      "type": "number",
      "default": 96,
      "description": "Horizontal overlap between resting cards in pixels.",
      "remixer": {
        "control": "range",
        "group": "layout",
        "groupTitle": "Layout",
        "min": 0,
        "max": 200,
        "step": 2
      }
    },
    {
      "name": "pushDistance",
      "type": "number",
      "default": 235,
      "description": "Distance neighboring cards are pushed aside on hover.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 100,
        "max": 400,
        "step": 5
      }
    },
    {
      "name": "hoverLift",
      "type": "number",
      "default": 30,
      "description": "Vertical lift applied to the hovered card in pixels.",
      "remixer": {
        "control": "range",
        "group": "behavior",
        "groupTitle": "Behavior",
        "min": 0,
        "max": 100,
        "step": 2
      }
    },
    {
      "name": "spread",
      "type": "number",
      "description": "Distance cards spread while hovered.",
      "default": 24,
      "remixer": {
        "control": "range",
        "group": "controls",
        "groupTitle": "Controls",
        "min": 0,
        "max": 72,
        "step": 1
      }
    },
    {
      "name": "rotation",
      "type": "number",
      "description": "Rotation amount applied to stacked items.",
      "default": 7,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": -180,
        "max": 180,
        "step": 1
      }
    },
    {
      "name": "duration",
      "type": "number",
      "description": "Hover animation duration.",
      "default": 0.35,
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 5,
        "step": 0.05
      }
    },
    {
      "name": "accentColor",
      "type": "color",
      "description": "Outline color shown around the active card. Transparent by default.",
      "default": "transparent",
      "remixer": {
        "control": "color",
        "group": "style",
        "groupTitle": "Style"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "defaultOpenGroupId": "layout",
    "layout": {
      "buttonClassName": "right-4! top-25!",
      "panelClassName": "right-0! top-[132px]! h-[calc(100%-132px)]! w-[344px]!"
    },
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
