{
  "name": "animated-dropdown-menu",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Dropdown Menu",
  "description": "A menu of actions or options that opens from a button.",
  "category": "components",
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "gsap",
    "motion",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-dropdown-menu",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedDropdownMenu",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-dropdown-menu",
  "target": "src/components/effects/animated-dropdown-menu",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-dropdown-menu/index.tsx"
    }
  ],
  "props": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "string",
      "default": "ghibli",
      "description": "Colour palette, menu included. The highlighted item and the selection pill take its primary colour.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Caffeine",
            "value": "caffeine"
          },
          {
            "label": "Claude",
            "value": "claude"
          },
          {
            "label": "Ghibli",
            "value": "ghibli"
          },
          {
            "label": "Spotify",
            "value": "spotify"
          },
          {
            "label": "Valorant",
            "value": "valorant"
          },
          {
            "label": "Vscode",
            "value": "vscode"
          }
        ]
      }
    },
    {
      "name": "mode",
      "label": "Mode",
      "type": "string",
      "default": "dark",
      "description": "Light or dark version of the palette. Starts dark.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          }
        ]
      }
    },
    {
      "name": "animation",
      "label": "Animation",
      "type": "string",
      "default": "slide",
      "description": "How the menu opens: collapse, slide, scale, reveal or morph.",
      "remixer": {
        "control": "select",
        "group": "panel",
        "groupTitle": "Panel",
        "options": [
          {
            "label": "Collapse",
            "value": "collapse"
          },
          {
            "label": "Slide",
            "value": "slide"
          },
          {
            "label": "Scale",
            "value": "scale"
          },
          {
            "label": "Reveal",
            "value": "reveal"
          },
          {
            "label": "Morph",
            "value": "morph"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "exitFast",
      "label": "Exit fast",
      "type": "boolean",
      "default": false,
      "description": "The menu closes faster than it opens.",
      "remixer": {
        "control": "checkbox",
        "group": "panel",
        "groupTitle": "Panel",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "duration",
      "label": "Duration",
      "type": "number",
      "default": 0.35,
      "description": "How long the open animation takes, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0.1,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "delay",
      "label": "Delay",
      "type": "number",
      "default": 0.1,
      "description": "Wait before the menu starts opening, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 0.5,
        "step": 0.01,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "stagger",
      "label": "Stagger",
      "type": "number",
      "default": 0.05,
      "description": "Delay between each item appearing, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 0.2,
        "step": 0.01,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "itemHighlight",
      "label": "Item highlight",
      "type": "string",
      "default": "slide",
      "description": "How the highlight moves between items: slides, fills from the top, or none.",
      "remixer": {
        "control": "select",
        "group": "options",
        "groupTitle": "Options",
        "options": [
          {
            "label": "Slide",
            "value": "slide"
          },
          {
            "label": "Fill from top",
            "value": "fill"
          },
          {
            "label": "None",
            "value": "none"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "selectionIndicator",
      "label": "Selection indicator",
      "type": "string",
      "default": "dot",
      "description": "Mark shown on the chosen item: check, dot or bar.",
      "remixer": {
        "control": "select",
        "group": "options",
        "groupTitle": "Options",
        "options": [
          {
            "label": "Check",
            "value": "check"
          },
          {
            "label": "Dot",
            "value": "dot"
          },
          {
            "label": "Bar",
            "value": "bar"
          }
        ]
      }
    },
    {
      "name": "showDescriptions",
      "label": "Descriptions",
      "type": "boolean",
      "default": false,
      "description": "Shows a short description under each item.",
      "remixer": {
        "control": "checkbox",
        "group": "options",
        "groupTitle": "Options"
      }
    },
    {
      "name": "bold",
      "label": "Bold",
      "type": "boolean",
      "default": true,
      "description": "Makes the item labels bold.",
      "remixer": {
        "control": "checkbox",
        "group": "options",
        "groupTitle": "Options"
      }
    },
    {
      "name": "rollingText",
      "label": "Rolling text",
      "type": "boolean",
      "default": true,
      "description": "Item labels roll to a second copy on hover.",
      "remixer": {
        "control": "checkbox",
        "group": "options",
        "groupTitle": "Options",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "icon",
      "label": "Icon",
      "type": "string",
      "default": "plus",
      "description": "Icon on the trigger: plus that turns to minus, or a chevron.",
      "remixer": {
        "control": "select",
        "group": "trigger",
        "groupTitle": "Trigger",
        "options": [
          {
            "label": "Plus / minus",
            "value": "plus"
          },
          {
            "label": "Chevron",
            "value": "chevron"
          }
        ]
      }
    },
    {
      "name": "rollingValue",
      "label": "Rolling value",
      "type": "boolean",
      "default": true,
      "description": "The chosen value in the trigger rolls to the new one when it changes.",
      "remixer": {
        "control": "checkbox",
        "group": "trigger",
        "groupTitle": "Trigger",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "pressFeedback",
      "label": "Press feedback",
      "type": "boolean",
      "default": true,
      "description": "Items squeeze slightly when pressed.",
      "remixer": {
        "control": "checkbox",
        "group": "trigger",
        "groupTitle": "Trigger",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "openOnHover",
      "label": "Open on hover",
      "type": "boolean",
      "default": false,
      "description": "Opens the menu when you hover the trigger, not only on click.",
      "remixer": {
        "control": "checkbox",
        "group": "trigger",
        "groupTitle": "Trigger"
      }
    },
    {
      "name": "closeDelayOnSelect",
      "label": "Close delay on select",
      "type": "boolean",
      "default": false,
      "description": "Waits a moment after a pick so you see the selection before the menu closes.",
      "remixer": {
        "control": "checkbox",
        "group": "behaviour",
        "groupTitle": "Behaviour"
      }
    },
    {
      "name": "typeahead",
      "label": "Type to jump",
      "type": "boolean",
      "default": false,
      "description": "With the menu open, typing a letter moves the highlight to the first item starting with it (P jumps to Paused). Off: letter keys do nothing.",
      "remixer": {
        "control": "checkbox",
        "group": "behaviour",
        "groupTitle": "Behaviour"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
