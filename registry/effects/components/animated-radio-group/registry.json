{
  "name": "animated-radio-group",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Radio Group",
  "description": "Pick one option. Arrow keys, Home and End move the choice.",
  "category": "components",
  "dependencies": [
    "motion"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-radio-group",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedRadioGroup",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-radio-group",
  "target": "src/components/effects/animated-radio-group",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-radio-group/index.tsx"
    }
  ],
  "props": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "string",
      "default": "valorant",
      "description": "Colour palette. The selected radio and its dot take its primary colour; the selected card too when Card fill color is Accent.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Caffeine",
            "value": "caffeine"
          },
          {
            "label": "Claude",
            "value": "claude"
          },
          {
            "label": "Ghibli",
            "value": "ghibli"
          },
          {
            "label": "Spotify",
            "value": "spotify"
          },
          {
            "label": "Valorant",
            "value": "valorant"
          },
          {
            "label": "Vscode",
            "value": "vscode"
          }
        ]
      }
    },
    {
      "name": "mode",
      "label": "Mode",
      "type": "string",
      "default": "dark",
      "description": "Light or dark version of the palette. Starts dark.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          }
        ]
      }
    },
    {
      "name": "variant",
      "label": "Style",
      "type": "string",
      "default": "card",
      "description": "Inline radios or bordered cards.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "label": "Inline",
            "value": "default"
          },
          {
            "label": "Cards",
            "value": "card"
          }
        ]
      }
    },
    {
      "name": "cardFillColor",
      "label": "Card fill color",
      "type": "string",
      "default": "accent",
      "description": "Fill of the selected card: a muted tint or the solid accent. Needs Style set to Cards.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "label": "Muted",
            "value": "muted"
          },
          {
            "label": "Accent",
            "value": "accent"
          }
        ],
        "disabledWhen": {
          "prop": "variant",
          "equals": "default"
        }
      }
    },
    {
      "name": "showIcon",
      "label": "Icon",
      "type": "boolean",
      "default": true,
      "description": "Show the radio circle next to each label.",
      "remixer": {
        "control": "checkbox",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "showDescription",
      "label": "Description",
      "type": "boolean",
      "default": true,
      "description": "Show each option's description line.",
      "remixer": {
        "control": "checkbox",
        "group": "style",
        "groupTitle": "Style"
      }
    },
    {
      "name": "slideDot",
      "label": "Slide dot",
      "type": "boolean",
      "default": false,
      "description": "The dot glides from the old choice to the new one. Needs Icon on, and not used by the Full look.",
      "remixer": {
        "control": "checkbox",
        "hideWhenReducedMotion": true,
        "group": "choosing",
        "groupTitle": "Choosing",
        "disabledWhen": [
          {
            "prop": "appearance",
            "equals": "full"
          },
          {
            "prop": "showIcon",
            "equals": false
          }
        ]
      }
    },
    {
      "name": "slideCard",
      "label": "Slide card",
      "type": "boolean",
      "default": true,
      "description": "The card highlight glides between cards. Needs Style set to Cards.",
      "remixer": {
        "control": "checkbox",
        "hideWhenReducedMotion": true,
        "group": "choosing",
        "groupTitle": "Choosing",
        "disabledWhen": {
          "prop": "variant",
          "equals": "default"
        }
      }
    },
    {
      "name": "elastic",
      "label": "Elastic",
      "type": "boolean",
      "default": true,
      "description": "The radio squashes and springs back when picked. Needs Icon on.",
      "remixer": {
        "control": "checkbox",
        "hideWhenReducedMotion": true,
        "group": "choosing",
        "groupTitle": "Choosing",
        "disabledWhen": {
          "prop": "showIcon",
          "equals": false
        }
      }
    },
    {
      "name": "appearance",
      "label": "Look",
      "type": "string",
      "default": "outline",
      "description": "Radio look: an outline ring, a filled ring or one solid circle. Needs Icon on.",
      "remixer": {
        "control": "select",
        "group": "radio",
        "groupTitle": "Radio",
        "options": [
          {
            "label": "Outline",
            "value": "outline"
          },
          {
            "label": "Filled",
            "value": "filled"
          },
          {
            "label": "Full",
            "value": "full"
          }
        ],
        "disabledWhen": {
          "prop": "showIcon",
          "equals": false
        }
      }
    },
    {
      "name": "reorder",
      "label": "Drag to reorder",
      "type": "boolean",
      "default": true,
      "description": "Drag options up and down to reorder them.",
      "remixer": {
        "control": "checkbox",
        "group": "group",
        "groupTitle": "Group"
      }
    },
    {
      "name": "colorful",
      "label": "Colour per option",
      "type": "boolean",
      "default": false,
      "description": "Use each option's own accent colour.",
      "remixer": {
        "control": "checkbox",
        "group": "group",
        "groupTitle": "Group"
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
