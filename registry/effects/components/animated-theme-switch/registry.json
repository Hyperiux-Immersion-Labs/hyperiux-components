{
  "name": "animated-theme-switch",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Theme Switch",
  "description": "Switch between light and dark with a transition.",
  "category": "components",
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "gsap",
    "lucide-react",
    "motion",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-theme-switch",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedThemeSwitch",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-theme-switch",
  "target": "src/components/effects/animated-theme-switch",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-theme-switch/index.tsx"
    }
  ],
  "props": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "string",
      "default": "spotify",
      "description": "Colour palette. Any theme but Default also tints the sun and moon icon, except on the Default button, which is already primary.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Caffeine",
            "value": "caffeine"
          },
          {
            "label": "Claude",
            "value": "claude"
          },
          {
            "label": "Ghibli",
            "value": "ghibli"
          },
          {
            "label": "Spotify",
            "value": "spotify"
          },
          {
            "label": "Valorant",
            "value": "valorant"
          },
          {
            "label": "Vscode",
            "value": "vscode"
          }
        ]
      }
    },
    {
      "name": "revealAnimation",
      "label": "Reveal animation",
      "type": "string",
      "default": "circle",
      "description": "How the new theme spreads over the old one.",
      "remixer": {
        "control": "select",
        "group": "transition",
        "groupTitle": "Transition",
        "options": [
          {
            "label": "Circle from button",
            "value": "circle"
          },
          {
            "label": "Swipe",
            "value": "swipe"
          },
          {
            "label": "Fade",
            "value": "fade"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "duration",
      "label": "Duration",
      "type": "number",
      "default": 0.85,
      "description": "How long the theme change takes, in seconds.",
      "remixer": {
        "control": "range",
        "group": "transition",
        "groupTitle": "Transition",
        "min": 0.2,
        "max": 2,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "iconAnimation",
      "label": "Icon motion",
      "type": "string",
      "default": "orbit",
      "description": "How the sun and moon icons swap.",
      "remixer": {
        "control": "select",
        "group": "button",
        "groupTitle": "Button",
        "options": [
          {
            "label": "Spin",
            "value": "spin"
          },
          {
            "label": "Orbit",
            "value": "orbit"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "showTooltip",
      "label": "Tooltip",
      "type": "boolean",
      "default": true,
      "description": "Shows a tooltip naming the theme the button switches to.",
      "remixer": {
        "control": "checkbox",
        "group": "button",
        "groupTitle": "Button"
      }
    },
    {
      "name": "variant",
      "label": "Look",
      "type": "string",
      "default": "outline",
      "description": "Style of the button: outline, ghost (no border) or filled.",
      "remixer": {
        "control": "select",
        "group": "button",
        "groupTitle": "Button",
        "options": [
          {
            "label": "Outline",
            "value": "outline"
          },
          {
            "label": "Ghost",
            "value": "ghost"
          },
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Secondary",
            "value": "secondary"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
