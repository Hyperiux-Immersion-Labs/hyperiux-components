{
  "name": "animated-tabs-bar",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Tabs Bar",
  "description": "Switch between views; the highlight glides to the active tab.",
  "category": "components",
  "dependencies": [
    "@base-ui/react",
    "motion",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-tabs-bar",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedTabsBar",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-tabs-bar",
  "target": "src/components/effects/animated-tabs-bar",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-tabs-bar/index.tsx"
    }
  ],
  "props": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "string",
      "default": "ghibli",
      "description": "Colour palette. The Primary pill and the underlines use its primary colour; any theme but Default also tints the active tab's text with the underline styles.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Caffeine",
            "value": "caffeine"
          },
          {
            "label": "Claude",
            "value": "claude"
          },
          {
            "label": "Ghibli",
            "value": "ghibli"
          },
          {
            "label": "Spotify",
            "value": "spotify"
          },
          {
            "label": "Valorant",
            "value": "valorant"
          },
          {
            "label": "Vscode",
            "value": "vscode"
          }
        ]
      }
    },
    {
      "name": "mode",
      "label": "Mode",
      "type": "string",
      "default": "light",
      "description": "Light or dark version of the palette.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          }
        ]
      }
    },
    {
      "name": "activeIndicator",
      "label": "Active indicator",
      "type": "string",
      "default": "glide",
      "description": "How the active tab is marked: a pill or underline that glides to it, or an underline that fades in.",
      "remixer": {
        "control": "select",
        "group": "tabs",
        "groupTitle": "Tabs",
        "options": [
          {
            "label": "Glide pill",
            "value": "glide"
          },
          {
            "label": "Slide underline",
            "value": "underline"
          },
          {
            "label": "Fade underline",
            "value": "fade"
          }
        ]
      }
    },
    {
      "name": "activeColor",
      "label": "Active tab colour",
      "type": "string",
      "default": "primary",
      "description": "Colour of the gliding pill. Only used by Glide pill.",
      "remixer": {
        "control": "select",
        "group": "tabs",
        "groupTitle": "Tabs",
        "options": [
          {
            "label": "Primary",
            "value": "primary"
          },
          {
            "label": "Muted",
            "value": "muted"
          }
        ],
        "disabledWhen": {
          "prop": "activeIndicator",
          "notEquals": "glide"
        }
      }
    },
    {
      "name": "hoverHighlight",
      "label": "Hover highlight",
      "type": "boolean",
      "default": true,
      "description": "Highlights the tab under the pointer.",
      "remixer": {
        "control": "checkbox",
        "group": "tabs",
        "groupTitle": "Tabs"
      }
    },
    {
      "name": "divider",
      "label": "Line under tabs",
      "type": "boolean",
      "default": true,
      "description": "Draws a line under the row of tabs.",
      "remixer": {
        "control": "checkbox",
        "group": "tabs",
        "groupTitle": "Tabs"
      }
    },
    {
      "name": "listBorder",
      "label": "Border on tabs",
      "type": "boolean",
      "default": true,
      "description": "Draws a border around the row of tabs.",
      "remixer": {
        "control": "checkbox",
        "group": "tabs",
        "groupTitle": "Tabs"
      }
    },
    {
      "name": "panelBorder",
      "label": "Border on content",
      "type": "boolean",
      "default": false,
      "description": "Draws a border around the tab content.",
      "remixer": {
        "control": "checkbox",
        "group": "content",
        "groupTitle": "Content"
      }
    },
    {
      "name": "rounded",
      "label": "Roundness",
      "type": "string",
      "default": "md",
      "description": "Corner radius of the tabs, the pill and the borders.",
      "remixer": {
        "control": "select",
        "group": "tabs",
        "groupTitle": "Tabs",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "sm",
            "value": "sm"
          },
          {
            "label": "md",
            "value": "md"
          },
          {
            "label": "lg",
            "value": "lg"
          },
          {
            "label": "xl",
            "value": "xl"
          },
          {
            "label": "Full",
            "value": "full"
          }
        ]
      }
    },
    {
      "name": "contentAnimation",
      "label": "Content animation",
      "type": "string",
      "default": "slide",
      "description": "How content changes when you switch tabs.",
      "remixer": {
        "control": "select",
        "group": "content",
        "groupTitle": "Content",
        "options": [
          {
            "label": "Slide",
            "value": "slide"
          },
          {
            "label": "Fade in / out",
            "value": "fade"
          },
          {
            "label": "None",
            "value": "none"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "slideDistance",
      "label": "Slide distance",
      "type": "number",
      "default": 40,
      "description": "How far content slides when switching tabs, in pixels. Needs Content animation set to Slide.",
      "remixer": {
        "control": "range",
        "group": "content",
        "groupTitle": "Content",
        "min": 0,
        "max": 120,
        "step": 4,
        "disabledWhen": {
          "prop": "contentAnimation",
          "notEquals": "slide"
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "smoothHeight",
      "label": "Smooth panel height",
      "type": "boolean",
      "default": false,
      "description": "The content area animates to each tab's height instead of jumping.",
      "remixer": {
        "control": "checkbox",
        "group": "content",
        "groupTitle": "Content",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "fadeDuration",
      "label": "Fade duration",
      "type": "number",
      "default": 0.35,
      "description": "How long the fade takes, in seconds. Needs Content animation set to Fade in / out.",
      "remixer": {
        "control": "range",
        "group": "content",
        "groupTitle": "Content",
        "min": 0.1,
        "max": 1.2,
        "step": 0.05,
        "disabledWhen": {
          "prop": "contentAnimation",
          "notEquals": "fade"
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "duration",
      "label": "Duration",
      "type": "number",
      "default": 0.3,
      "description": "How long the indicator and content take to move, in seconds.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0.1,
        "max": 1,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "bounce",
      "label": "Bounce",
      "type": "number",
      "default": 0.15,
      "description": "Springiness of the indicator and slide. Does nothing with Fade underline unless Content animation is Slide.",
      "remixer": {
        "control": "range",
        "group": "motion",
        "groupTitle": "Motion",
        "min": 0,
        "max": 0.6,
        "step": 0.05,
        "hideWhenReducedMotion": true
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
