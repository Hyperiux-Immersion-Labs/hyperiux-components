{
  "name": "animated-hover-card",
  "version": "1.0.0",
  "changelog": [
    {
      "version": "1.0.0",
      "date": "2026-10-23",
      "summary": "Initial release",
      "breaking": false
    }
  ],
  "type": "registry:component",
  "title": "Animated Hover Card",
  "description": "A preview that appears when you hover a link.",
  "category": "components",
  "dependencies": [
    "@base-ui/react",
    "class-variance-authority",
    "lucide-react",
    "motion",
    "tailwind-merge"
  ],
  "registryDependencies": [],
  "previewUrl": "/demo/animated-hover-card",
  "tier": "free",
  "subfolder": true,
  "main": "index.tsx",
  "exportName": "AnimatedHoverCard",
  "exportKind": "default",
  "importPath": "@/components/effects/animated-hover-card",
  "target": "src/components/effects/animated-hover-card",
  "files": [
    {
      "path": "index.tsx",
      "target": "src/components/effects/animated-hover-card/index.tsx"
    }
  ],
  "props": [
    {
      "name": "theme",
      "label": "Theme",
      "type": "string",
      "default": "valorant",
      "description": "Colour palette, card included. Its primary colour fills the card's button.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Default",
            "value": "default"
          },
          {
            "label": "Caffeine",
            "value": "caffeine"
          },
          {
            "label": "Claude",
            "value": "claude"
          },
          {
            "label": "Ghibli",
            "value": "ghibli"
          },
          {
            "label": "Spotify",
            "value": "spotify"
          },
          {
            "label": "Valorant",
            "value": "valorant"
          },
          {
            "label": "Vscode",
            "value": "vscode"
          }
        ]
      }
    },
    {
      "name": "mode",
      "label": "Mode",
      "type": "string",
      "default": "dark",
      "description": "Light or dark version of the palette. Starts dark.",
      "remixer": {
        "control": "select",
        "group": "theme",
        "groupTitle": "Theme",
        "options": [
          {
            "label": "Light",
            "value": "light"
          },
          {
            "label": "Dark",
            "value": "dark"
          }
        ]
      }
    },
    {
      "name": "site",
      "label": "Website",
      "type": "string",
      "default": "vault.hyperiux.com",
      "description": "Website the card previews. Needs Card shows set to Website preview.",
      "remixer": {
        "control": "text",
        "group": "content",
        "groupTitle": "Content",
        "placeholder": "Site name or link",
        "disabledWhen": {
          "prop": "source",
          "notEquals": "link"
        }
      }
    },
    {
      "name": "source",
      "label": "Card shows",
      "type": "string",
      "default": "link",
      "description": "What the card shows: a preview of the website or manually written details.",
      "remixer": {
        "control": "select",
        "group": "content",
        "groupTitle": "Content",
        "options": [
          {
            "label": "Website preview",
            "value": "link"
          },
          {
            "label": "Manual details",
            "value": "text"
          }
        ]
      }
    },
    {
      "name": "contentAnimation",
      "label": "Content animation",
      "type": "string",
      "default": "scale",
      "description": "How the card appears: scales and fades, or only fades.",
      "remixer": {
        "control": "select",
        "group": "opening",
        "groupTitle": "Opening",
        "options": [
          {
            "label": "Scale + fade",
            "value": "scale"
          },
          {
            "label": "Fade",
            "value": "fade"
          }
        ],
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "startScale",
      "label": "Start scale",
      "type": "number",
      "default": 0.9,
      "description": "Size the card starts from when it opens, as a fraction of full size.",
      "remixer": {
        "control": "range",
        "group": "opening",
        "groupTitle": "Opening",
        "min": 0.5,
        "max": 1,
        "step": 0.05,
        "disabledWhen": {
          "prop": "contentAnimation",
          "equals": "fade"
        },
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "fadeContent",
      "label": "Fade content",
      "type": "boolean",
      "default": true,
      "description": "Fades the card contents in as it opens.",
      "remixer": {
        "control": "checkbox",
        "group": "opening",
        "groupTitle": "Opening",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "openDelay",
      "label": "Open after",
      "type": "number",
      "default": 0.7,
      "description": "How long you hover before the card opens, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "name": "closeDelay",
      "label": "Close after",
      "type": "number",
      "default": 0,
      "description": "How long after leaving before the card closes, in seconds.",
      "remixer": {
        "control": "range",
        "group": "timing",
        "groupTitle": "Timing",
        "min": 0,
        "max": 1,
        "step": 0.05
      }
    },
    {
      "name": "followCursor",
      "label": "Follow the pointer",
      "type": "boolean",
      "default": true,
      "description": "The card follows the pointer instead of staying put.",
      "remixer": {
        "control": "checkbox",
        "group": "link",
        "groupTitle": "Link"
      }
    },
    {
      "name": "underline",
      "label": "Underline draws in",
      "type": "boolean",
      "default": true,
      "description": "The link underline draws in on hover.",
      "remixer": {
        "control": "checkbox",
        "group": "link",
        "groupTitle": "Link",
        "hideWhenReducedMotion": true
      }
    },
    {
      "name": "rounded",
      "label": "Roundness",
      "type": "string",
      "default": "md",
      "description": "Corner radius of the card.",
      "remixer": {
        "control": "select",
        "group": "style",
        "groupTitle": "Style",
        "options": [
          {
            "label": "None",
            "value": "none"
          },
          {
            "label": "sm",
            "value": "sm"
          },
          {
            "label": "md",
            "value": "md"
          },
          {
            "label": "lg",
            "value": "lg"
          },
          {
            "label": "xl",
            "value": "xl"
          },
          {
            "label": "2xl",
            "value": "2xl"
          }
        ]
      }
    }
  ],
  "remixer": {
    "enabled": true,
    "layout": "panel",
    "copyCode": {
      "includeOnlyPublicProps": true
    }
  }
}
